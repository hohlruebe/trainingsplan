  "entscheidungen": [
    {
      "frage": "P1: g_tuck_planche sehne 2 oder 1?",
      "entscheidung": "2.",
      "folge": "Die Sehnenbelastung kommt von den gestreckten Armen, nicht von der Hebellänge."
    },
    {
      "frage": "P2: Planche-Familie, Ellbogen 3 bei welchen Stufen?",
      "entscheidung": "3 bei Full und Straddle Planche, 2 bei Tuck und Advanced Tuck.",
      "folge": "Bei Ellbogenschmerzen bleibt eine leichtere Stufe in der Familie."
    },
    {
      "frage": "P3: g_tuck_planche Schulter 3 oder 2?",
      "entscheidung": "2, Advanced Tuck 3.",
      "folge": "Die Stufenfolge bildet die Schulterbelastung ab."
    },
    {
      "frage": "P4: Planche Lean und Pseudo Planche Push-up, Handgelenk 3 oder 2?",
      "entscheidung": "3 für beide.",
      "folge": "Bei Handgelenkschmerzen filtert der Coach beide sicher aus."
    },
    {
      "frage": "P5: g_push Handgelenk 2 oder 1?",
      "entscheidung": "2.",
      "folge": "Parallettes und Ringe mit Handgelenk 1 sind die Ausweichübungen bei Handgelenkschmerzen."
    },
    {
      "frage": "P6: g_plyo_push Handgelenk 3 und laut true?",
      "entscheidung": "Handgelenk 3, laut true.",
      "folge": "Der Plyo Push-up gilt nie als gleich belastend wie der normale Liegestütz."
    },
    {
      "frage": "P7: g_push_knee Knie 1?",
      "entscheidung": "1.",
      "folge": "Bei Knieschmerzen schlägt der Coach nicht den Knieliegestütz vor."
    },
    {
      "frage": "P8: sehne bei Nicht-Leitern?",
      "entscheidung": "Ring Push-up 1, Plyo Push-up 1, Incline One-Arm Push-up 1, Archer Push-up 0.",
      "folge": "Ringe und Sprünge nach Konvention, der Archer passt zum Archer Pull-up."
    },
    {
      "frage": "P9: ermuedung im Paket?",
      "entscheidung": "1 für die Grundformen, 2 für Weighted, Archer, One-Arm, Plyo, Bench Press und die Planche-Halteübungen.",
      "folge": "Den Wiederholungsumfang steuert das Workout, nicht die Übung."
    },
    {
      "frage": "P10: Bench Press Schulter 2 oder 3?",
      "entscheidung": "2.",
      "folge": "Der Floor Press mit Schulter 1 ist die Ausweichübung bei Schulterschmerzen."
    },
